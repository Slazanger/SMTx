<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SMTx.ViewModels"
             x:Class="SMTx.Views.MainShellHeaderView"
             x:DataType="vm:MainViewModel">
  <Border Background="{StaticResource EveBgElevatedBrush}"
          BorderBrush="{StaticResource EveBorderBrush}"
          BorderThickness="0,0,0,1"
          Padding="12,8">
    <Grid ColumnDefinitions="Auto,*,Auto">
      <TextBlock Grid.Column="0"
                 Text="SMTx"
                 VerticalAlignment="Center"
                 FontSize="18"
                 FontWeight="SemiBold"
                 Foreground="{StaticResource EveTextEmphasisBrush}"
                 Margin="0,0,24,0" />
      <ListBox Grid.Column="1"
               ItemsSource="{Binding ShellTabOptions}"
               SelectedItem="{Binding SelectedShellTabOption}"
               Background="Transparent"
               BorderThickness="0"
               Padding="0"
               HorizontalAlignment="Center"
               VerticalAlignment="Center">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="2" />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate DataType="vm:ShellTabOption">
            <TextBlock Text="{Binding DisplayName}"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource EveTextMutedBrush}" />
          </DataTemplate>
        </ListBox.ItemTemplate>
        <ListBox.Styles>
          <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="4" />
          </Style>
          <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource EveSelectionBrush}" />
          </Style>
          <Style Selector="ListBoxItem:selected TextBlock">
            <Setter Property="Foreground" Value="{StaticResource EveAccentBrush}" />
          </Style>
          <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource EveHoverBrush}" />
          </Style>
        </ListBox.Styles>
      </ListBox>
      <StackPanel Grid.Column="2"
                  Orientation="Horizontal"
                  Spacing="20"
                  VerticalAlignment="Center"
                  Margin="16,0,0,0">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Border Width="10" Height="10" Background="{StaticResource EveWarningBrush}" CornerRadius="1" VerticalAlignment="Center" />
          <TextBlock VerticalAlignment="Center" Foreground="{StaticResource EveTextMutedBrush}" FontSize="12">
            <Run Text="Alerts: " />
            <Run Text="{Binding AlertCount}" />
          </TextBlock>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Border Width="10" Height="10" Background="{StaticResource EveNotificationBrush}" CornerRadius="1" VerticalAlignment="Center" />
          <TextBlock VerticalAlignment="Center" Foreground="{StaticResource EveTextMutedBrush}" FontSize="12">
            <Run Text="Notifications: " />
            <Run Text="{Binding NotificationCount}" />
          </TextBlock>
        </StackPanel>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
