<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SMTx.ViewModels"
             xmlns:models="clr-namespace:SMTx.Models"
             xmlns:views="clr-namespace:SMTx.Views"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="SMTx.Views.MainView"
             x:DataType="vm:MainViewModel"
             Background="{StaticResource EveBgAppBrush}">
  <Design.DataContext>
    <vm:MainViewModel />
  </Design.DataContext>

  <Grid RowDefinitions="Auto,*">
    <views:MainShellHeaderView Grid.Row="0" />

    <Grid Grid.Row="1">
      <views:HomeTabPanelView
          IsVisible="{Binding SelectedShellTab, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static models:MainShellTab.Home}}" />

      <views:IntelShellTabPanelView
          IsVisible="{Binding SelectedShellTab, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static models:MainShellTab.Intel}}" />

      <views:CharactersTabPanelView
          IsVisible="{Binding SelectedShellTab, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static models:MainShellTab.Characters}}" />

      <views:SettingsTabPanelView
          IsVisible="{Binding SelectedShellTab, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static models:MainShellTab.Settings}}" />

      <views:AboutShellTabPanelView
          IsVisible="{Binding SelectedShellTab, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static models:MainShellTab.About}}" />
    </Grid>
  </Grid>
</UserControl>
