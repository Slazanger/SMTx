<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SMTx.ViewModels"
             xmlns:models="clr-namespace:SMTx.Models"
             x:Class="SMTx.Views.HomeIntelActivityPanelView"
             x:DataType="vm:MainViewModel">
  <Border Background="{StaticResource EveBgElevatedBrush}"
          BorderBrush="{StaticResource EveBorderBrush}"
          BorderThickness="1,0,0,0">
    <Grid RowDefinitions="2*,*">
      <Grid Grid.Row="0" RowDefinitions="Auto,*">
        <Border Grid.Row="0" Background="{StaticResource EveBgSubHeaderBrush}" Padding="10,8">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <Button Content="Intel"
                    Padding="8,4"
                    Command="{Binding SelectHomeIntelPanelTabCommand}"
                    CommandParameter="{x:Static models:HomeIntelPanelTab.Intel}" />
            <Button Content="Log"
                    Padding="8,4"
                    Command="{Binding SelectHomeIntelPanelTabCommand}"
                    CommandParameter="{x:Static models:HomeIntelPanelTab.Log}" />
          </StackPanel>
        </Border>
        <ListBox Grid.Row="1"
                 ItemsSource="{Binding MockIntelLines}"
                 Background="Transparent"
                 BorderThickness="0"
                 Margin="8,8,8,4"
                 IsVisible="{Binding IsHomeIntelPanelIntel}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4">
                <Border Width="3" Height="16" Background="{StaticResource EveIntelAccentBrush}" CornerRadius="1" VerticalAlignment="Center" />
                <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource EveTextEmphasisBrush}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Grid.Row="1"
                   Text="No log entries."
                   Margin="12"
                   Foreground="{StaticResource EveTextMutedBrush}"
                   IsVisible="{Binding IsHomeIntelPanelLog}" />
      </Grid>
      <Border Grid.Row="1" BorderBrush="{StaticResource EveBorderBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Text="Recent Activity" Foreground="{StaticResource EveTextEmphasisBrush}" FontWeight="SemiBold" Margin="10,0,10,6" />
          <ListBox Grid.Row="1"
                   ItemsSource="{Binding MockActivityLines}"
                   Background="Transparent"
                   BorderThickness="0"
                   Margin="4,0,4,4">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4">
                  <Border Width="8" Height="8" Background="{StaticResource EveErrorBrush}" CornerRadius="1" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource EveTextEmphasisBrush}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>
    </Grid>
  </Border>
</UserControl>
